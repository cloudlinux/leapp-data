# AlmaLinux repositories.
# Taken from AlmaLinux's own el10 file - CloudLinux 10 takes its EL base content
# from AlmaLinux 10, the same way CloudLinux 9 does from AlmaLinux 9.
#
# Note there is no almalinux10-resilientstorage: AlmaLinux dropped that repository
# in 10, so unlike the el9 file this one has no counterpart for it.

[almalinux10-baseos]
name=AlmaLinux $releasever - BaseOS
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/baseos
# baseurl=https://repo.almalinux.org/almalinux/$releasever/BaseOS/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/distro/cloudlinux/rpm-gpg/10/RPM-GPG-KEY-AlmaLinux-10

[almalinux10-appstream]
name=AlmaLinux $releasever - AppStream
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/appstream
# baseurl=https://repo.almalinux.org/almalinux/$releasever/AppStream/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/distro/cloudlinux/rpm-gpg/10/RPM-GPG-KEY-AlmaLinux-10

[almalinux10-crb]
name=AlmaLinux $releasever - CRB
mirrorlist=https://mirrors.almalinux.org/mirrorlist/$releasever/crb
# baseurl=https://repo.almalinux.org/almalinux/$releasever/CRB/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/leapp/repos.d/system_upgrade/common/files/distro/cloudlinux/rpm-gpg/10/RPM-GPG-KEY-AlmaLinux-10

