# CL repositories used during migration.
# Enabled so CloudLinux-specific packages are available when the source system
# is on the no-auth scheme and CLN is no longer serving them.

# cloudlinux10-channel is the whole CloudLinux 10 package set. Unlike CloudLinux
# 9 there is no BaseOS/AppStream split to fall back on - repo.cloudlinux.com
# serves /cloudlinux/10/cloudlinux-x86_64-server-10/ and returns 404 for
# /cloudlinux/10/BaseOS/ and /cloudlinux/10/AppStream/ - so this single channel
# is the only source of CloudLinux content for the target.
#
# The repoid is deliberately "cloudlinux10-channel" rather than "cl-channel", so
# it cannot clash with the source system's own cl-channel from
# /etc/yum.repos.d/cl.repo, which is carried into the target upgrade container
# and would otherwise trigger the "YUM/DNF repository defined multiple times"
# inhibitor. Same reasoning as cloudlinux9-channel in the el9 file.
#
# The mirrorlist names the major version literally instead of using $releasever,
# which is what the el9 file does. Minor-version routing is not populated for 10:
# cl-mirrors/cloudlinux-x86_64-server-10.0 (and .1, .2) resolve to a mirror root
# with no path at all, so a $releasever that expands to a minor version yields a
# broken repository. Revisit once minor routing exists for 10.
[cloudlinux10-channel]
name=CloudLinux 10 - SWNG mirrorlist
mirrorlist=https://repo.cloudlinux.com/cloudlinux/mirrorlists/cl-mirrors/cloudlinux-x86_64-server-10
# baseurl=https://repo.cloudlinux.com/cloudlinux/10/cloudlinux-x86_64-server-10/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CloudLinux
